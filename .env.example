# Names only. On Vercel set only the server variables from docs/deployment.md;
# MIGRATION_DATABASE_URL, BK_APP_DB_PASSWORD, NVIDIA_API_KEY and SUPABASE_ACCESS_TOKEN stay on your machine.

# Database (local values point at the embedded dev Postgres on port 54329)
MIGRATION_DATABASE_URL=postgresql://postgres:postgres@localhost:54329/belikongsi
DATABASE_URL=postgresql://bk_app:bk_app_dev@localhost:54329/belikongsi
BK_APP_DB_PASSWORD=bk_app_dev

# Supabase (production only)
SUPABASE_URL=<supabase-project-url>
SUPABASE_SERVICE_ROLE_KEY=<supabase-service-role-key>
# Per command only, never stored: used for the Supabase CLI and Management API
SUPABASE_ACCESS_TOKEN=<supabase-personal-access-token>

# AI
GEMINI_API_KEY=<gemini-api-key>
GEMINI_MODEL=gemini-3.5-flash-lite
# gemini or fake
AI_ADAPTER=fake
# Image generation, your machine only
NVIDIA_API_KEY=<nvidia-api-key>

# Storage: supabase or local
STORAGE_ADAPTER=local
# Folder for local storage (STORAGE_ADAPTER=local)
LOCAL_STORAGE_DIR=.data/storage

# Secrets (placeholders fail validation on purpose)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=<generate-32+-random-chars>
CRON_SECRET=<generate-me>

# Demo
DEMO_MODE=true

# Browser (restricted key, PRD section 18)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=<google-maps-browser-key>
